{% if lidarr_container_labels_traefik_enabled %}
traefik.enable=true

{% if lidarr_container_labels_traefik_docker_network %}
traefik.docker.network={{ lidarr_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if lidarr_container_labels_traefik_middleware_basic_auth_enabled %}
{% set middlewares = middlewares + [lidarr_identifier + '-basic-auth'] %}
traefik.http.middlewares.{{ lidarr_identifier }}-basic-auth.basicauth.users={{ lidarr_container_labels_traefik_middleware_basic_auth_users }}
{% endif %}

{% if lidarr_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ lidarr_identifier }}-slashless-redirect.redirectregex.regex=^({{ lidarr_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ lidarr_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [lidarr_identifier + '-slashless-redirect'] %}
{% endif %}

{% if lidarr_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ lidarr_identifier }}-strip-prefix.stripprefix.prefixes={{ lidarr_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [lidarr_identifier + '-strip-prefix'] %}
{% endif %}

{% if lidarr_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in lidarr_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ lidarr_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [lidarr_identifier + '-add-request-headers'] %}
{% endif %}

{% if lidarr_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in lidarr_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ lidarr_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [lidarr_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ lidarr_identifier }}.rule={{ lidarr_container_labels_traefik_rule }}
{% if lidarr_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ lidarr_identifier }}.priority={{ lidarr_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ lidarr_identifier }}.service={{ lidarr_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ lidarr_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ lidarr_identifier }}.entrypoints={{ lidarr_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ lidarr_identifier }}.tls={{ lidarr_container_labels_traefik_tls | to_json }}
{% if lidarr_container_labels_traefik_tls %}
traefik.http.routers.{{ lidarr_identifier }}.tls.certResolver={{ lidarr_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ lidarr_identifier }}.loadbalancer.server.port={{ lidarr_container_http_port }}
{% endif %}

{% for arg in lidarr_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
