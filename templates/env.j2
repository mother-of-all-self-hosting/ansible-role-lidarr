PUID={{ lidarr_uid }}
PGID={{ lidarr_gid }}

TZ={{ lidarr_environment_variables_tz }}

# Lidarr takes its port from the configuration file it maintains for itself under
# `lidarr_data_path`, which this role does not template. Without this override the
# container would keep listening on Lidarr's built-in 8686 no matter what
# `lidarr_container_http_port` says, while the port publishing and the Traefik
# labels would point at the configured port and find nothing there.
LIDARR__SERVER__PORT={{ lidarr_container_http_port }}

{{ lidarr_environment_variables_additional_variables }}
