[Unit]
Description=Lidarr ({{ lidarr_identifier }})
{% for service in lidarr_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in lidarr_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ lidarr_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ lidarr_identifier }} \
      --log-driver=none \
      --user={{ lidarr_uid }}:{{ lidarr_gid }} \
      --cap-drop=ALL \
      --cap-add=SETUID \
      --cap-add=SETGID \
      --cap-add=CHOWN \
      --cap-add=FOWNER \
      --cap-add=DAC_OVERRIDE \
      --read-only \
      --network={{ lidarr_container_network }} \
      {% if lidarr_container_http_host_bind_port %}
      -p {{ lidarr_container_http_host_bind_port }}:{{ lidarr_container_http_port }} \
      {% endif %}
      --env-file={{ lidarr_base_path }}/env \
      --label-file={{ lidarr_base_path }}/labels \
      --mount type=bind,src={{ lidarr_data_path }},dst=/config \
      {% for volume in lidarr_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      # https://docs.linuxserver.io/misc/read-only/#how
      --tmpfs=/run:rw,exec,nosuid,size=128m \
      {% for arg in lidarr_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ lidarr_container_image }}

{% for network in lidarr_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ lidarr_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ lidarr_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ lidarr_container_stop_grace_time_seconds }} {{ lidarr_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ lidarr_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ lidarr_identifier }}

[Install]
WantedBy=multi-user.target